{
  "info": {
    "name": "IDIQ API - Official Member Service (Updated)",
    "description": "Official IDIQ member-service API with test cases. Updated with correct base URL and endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{partnerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-stage.identityiq.com/member-service",
      "type": "string"
    },
    {
      "key": "partnerId",
      "value": "158096",
      "type": "string"
    },
    {
      "key": "partnerSecret",
      "value": "rWZwGjPZGccs3c8kFVOguZQWNeM=",
      "type": "string"
    },
    {
      "key": "planCode",
      "value": "PLAN03B",
      "type": "string"
    },
    {
      "key": "offerCode",
      "value": "431502GD",
      "type": "string"
    },
    {
      "key": "partnerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "membershipNo",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Get Partner Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('partnerToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('partnerToken', jsonData.accessToken);",
                  "    console.log('Partner Token saved:', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerId\": \"{{partnerId}}\",\n  \"partnerSecret\": \"{{partnerSecret}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/partner-token",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "partner-token"]
            },
            "description": "Get Partner Token for authentication. Run this FIRST."
          },
          "response": []
        },
        {
          "name": "Get Member Token (by Email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('memberToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('memberToken', jsonData.accessToken);",
                  "    console.log('Member Token saved:', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{partnerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberEmail\": \"{{memberEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/partner-member-token",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "partner-member-token"]
            },
            "description": "Get Member Token using email (not membership number). Run after enrollment."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Enrollment",
      "item": [
        {
          "name": "Enroll Member (Test User 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('membershipNo', jsonData.membershipNo);",
                  "    pm.collectionVariables.set('membershipNo', jsonData.membershipNo);",
                  "    console.log('Membership Number saved:', jsonData.membershipNo);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{partnerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"CHILI\",\n  \"lastName\": \"HOT\",\n  \"middleNameInitial\": \"\",\n  \"email\": \"chili.hot@testmail.com\",\n  \"birthDate\": \"01/01/1984\",\n  \"ssn\": \"666525461\",\n  \"street\": \"3325 ARMORY RD\",\n  \"city\": \"CASTLE HAYNE\",\n  \"state\": \"NC\",\n  \"zip\": \"28430\",\n  \"planCode\": \"{{planCode}}\",\n  \"offerCode\": \"{{offerCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "enroll"]
            },
            "description": "Enroll test user 1 (CHILI HOT). Returns membershipNo. Update email to unique address."
          },
          "response": []
        },
        {
          "name": "Enroll Member (Test User 2)",
          "event": [
            {
              "listen": "test",
