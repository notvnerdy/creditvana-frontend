              },
              {
                "key": "Authorization",
                "value": "Bearer {{partnerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"HEAT\",\n  \"lastName\": \"ED\",\n  \"middleNameInitial\": \"\",\n  \"email\": \"ed.heat@testmail.com\",\n  \"birthDate\": \"01/01/1984\",\n  \"ssn\": \"666254741\",\n  \"street\": \"4163 WHITE OAK DR\",\n  \"city\": \"MISSOURI CITY\",\n  \"state\": \"MO\",\n  \"zip\": \"64072\",\n  \"planCode\": \"{{planCode}}\",\n  \"offerCode\": \"{{offerCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "enroll"]
            },
            "description": "Enroll test user 2 (ED HEAT). Returns membershipNo. Update email to unique address."
          },
          "response": []
        },
        {
          "name": "Enroll Member (Test User 3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('membershipNo', jsonData.membershipNo);",
                  "    pm.collectionVariables.set('membershipNo', jsonData.membershipNo);",
                  "    console.log('Membership Number saved:', jsonData.membershipNo);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{partnerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"JOHN\",\n  \"lastName\": \"REAPER\",\n  \"middleNameInitial\": \"\",\n  \"email\": \"john.reaper@testmail.com\",\n  \"birthDate\": \"01/01/1984\",\n  \"ssn\": \"666254146\",\n  \"street\": \"805 WALNUT STREET\",\n  \"city\": \"JACKSON\",\n  \"state\": \"MS\",\n  \"zip\": \"39202\",\n  \"planCode\": \"{{planCode}}\",\n  \"offerCode\": \"{{offerCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "enroll"]
            },
            "description": "Enroll test user 3 (JOHN REAPER). Returns membershipNo. Update email to unique address."
          },
          "response": []
        },
        {
          "name": "Get Member Status (by Email)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{partnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/member-status?email={{memberEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "member-status"],
              "query": [
                {
                  "key": "email",
                  "value": "{{memberEmail}}"
                }
              ]
            },
            "description": "Get member status by email address"
          },
          "response": []
        },
        {
          "name": "Get Member Status (by Membership#)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{partnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/member-status?membership-number={{membershipNo}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "member-status"],
              "query": [
                {
                  "key": "membership-number",
                  "value": "{{membershipNo}}"
                }
              ]
            },
            "description": "Get member status by membership number"
          },
          "response": []
        },
        {
          "name": "Cancel Membership",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"offerCode\": \"{{offerCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/cancel-membership",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "cancel-membership"]
            },
            "description": "Cancel member's subscription"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Identity Verification (KBA)",
      "item": [
        {
          "name": "Get Verification Questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/verification-questions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "verification-questions"]
            },
            "description": "Get KBA verification questions for member"
          },
          "response": []
        },
        {
          "name": "Submit Verification Answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\"answer-id-1\", \"answer-id-2\", \"answer-id-3\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrollment/verification-questions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrollment", "verification-questions"]
            },
            "description": "Submit answers to verification questions. Use answer IDs from Get Questions response. Status: Correct, MoreQuestions, Incorrect, AccountCodeMissing, or Error."
          },
          "response": []
        }
      ]
    }
  ]
}
